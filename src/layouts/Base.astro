---
import { getConfig } from "@/utils/config";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
};

const { title, description, type, published, updated } = Astro.props;
const siteConfig = await getConfig();
---

<!doctype html>
<html lang={siteConfig.locale ?? "en"}>
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      published={published}
      updated={updated}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
