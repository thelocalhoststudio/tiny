---
import { getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import PostList from "@/components/PostList.astro";
import { getAllPosts } from "@/utils/content";
import { getConfig } from "@/utils/config";

const siteConfig = await getConfig();
const allPosts = await getAllPosts();
const recentPosts = allPosts.slice(0, 8);
const hasBrowse = (siteConfig.browse?.dimensions?.length ?? 0) > 0;

let HomeContent: any = null;
try {
  const homeEntry = await getEntry("pages", "home");
  if (homeEntry) {
    const rendered = await render(homeEntry);
    HomeContent = rendered.Content;
  }
} catch {
  // If no home.md entry exists, fallback
}
---

<Base>
  {HomeContent ? (
    <section class="home-intro">
      <HomeContent />
    </section>
  ) : (
    <section class="home-intro">
      <p class="home-intro-text">
        {siteConfig.description || "A minimalist personal publishing space. Notes, essays, and experiments."}
      </p>
    </section>
  )}

  <section class="home-writing">
    <h2>{siteConfig.ui?.writing || "Writing"}</h2>
    <PostList
      posts={recentPosts}
      showYear={true}
      showTags={true}
      showInboundCounts={siteConfig.features?.backlinks !== false}
    />

    <p class="home-archive-link">
      <a href="/posts">{siteConfig.ui?.allPosts || "All posts"} ({allPosts.length}) →</a>
      {hasBrowse && (
        <>
          <span class="meta-separator" aria-hidden="true"> · </span>
          <a href="/browse">Browse directory →</a>
        </>
      )}
    </p>
  </section>
</Base>

<style>
  .home-intro {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .home-intro :global(h1),
  .home-intro :global(h2),
  .home-intro :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .home-intro :global(p) {
    margin: 0.75rem 0;
    line-height: 1.65;
  }

  .home-intro-text {
    font-size: 1.1rem;
    line-height: 1.65;
    margin: 0;
  }

  .home-writing h2 {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }

  .home-archive-link {
    margin-top: 2rem;
    font-size: 0.95rem;
  }
</style>
