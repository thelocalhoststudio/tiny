---
import Base from "@/layouts/Base.astro";
import PostList from "@/components/PostList.astro";
import { getAllPosts, getPostsGroupedByYear } from "@/utils/content";

const posts = await getAllPosts();
const grouped = getPostsGroupedByYear(posts);
---

<Base title="Posts" description="All posts, newest first.">
  <h2>Posts</h2>
  {grouped.map(([year, yearPosts]) => (
    <section>
      <h3>{year}</h3>
      <PostList posts={yearPosts} />
    </section>
  ))}
</Base>
