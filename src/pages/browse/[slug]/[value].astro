---
import Base from "@/layouts/Base.astro";
import PostList from "@/components/PostList.astro";
import { getAllPosts } from "@/utils/content";
import { getBrowseValues, filterBrowseEntries, getBrowseDimensions } from "@/utils/browse";
import { titleify } from "@/utils/text";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const dimensions = await getBrowseDimensions();

  return dimensions.flatMap((dimension) =>
    getBrowseValues(posts, dimension.key).map((value) => ({
      params: { slug: dimension.slug, value: value.slug },
      props: { dimension, value },
    })),
  );
}

const { dimension, value } = Astro.props;
const posts = await getAllPosts();
const filtered = filterBrowseEntries(posts, dimension.key, value.slug);
---

<Base
  title={`${value.value} — ${dimension.label}`}
  description={`Posts filed under ${dimension.label.toLowerCase()}: ${value.value}.`}
>
  <div class="content-header__context">
    <a href={`/browse/${dimension.slug}`}>← {dimension.label}</a>
  </div>

  <h1>{titleify(value.value)}</h1>
  <p class="meta">
    {filtered.length} {filtered.length === 1 ? "post" : "posts"} in {dimension.label.toLowerCase()}.
  </p>

  <PostList posts={filtered} showYear={true} showTags={true} />
</Base>
