---
import { getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import ContentHeader from "@/components/ContentHeader.astro";
import AuthorBlock from "@/components/AuthorBlock.astro";
import { getConfig } from "@/utils/config";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing src/content/pages/about.md");

const { Content } = await render(page);
const siteConfig = await getConfig();
---

<Base title={page.data.title} description={page.data.description}>
  <article>
    <ContentHeader
      title={page.data.title}
      description={page.data.description}
    />

    {siteConfig.author && (
      <AuthorBlock
        name={siteConfig.author.name}
        url={siteConfig.author.url}
        avatar={siteConfig.author.avatar}
      />
    )}

    <div class="content-body">
      <Content />
    </div>
  </article>
</Base>
