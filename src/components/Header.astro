---
import { getConfig } from "@/utils/config";

const siteConfig = await getConfig();
---

<header>
  <a href="/" class="title">
    {siteConfig.author.avatar && (
      <img src={siteConfig.author.avatar} alt="" class="title-avatar" />
    )}
    <h1>{siteConfig.title}</h1>
  </a>

  {siteConfig.headerLinks && siteConfig.headerLinks.length > 0 && (
    <nav>
      {siteConfig.headerLinks.map((link) => <a href={link.url}>{link.label}</a>)}
    </nav>
  )}
</header>
