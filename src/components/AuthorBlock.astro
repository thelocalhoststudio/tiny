---
type Props = {
  name: string;
  url?: string;
  avatar?: string;
};

const { name, url, avatar } = Astro.props;
---

<div class="author">
  {avatar && <img src={avatar} alt={name} class="author-avatar" />}
  {name && (
    <div class="author-details">
      <h2 class="author-name">
        {url ? <a href={url}>{name}</a> : name}
      </h2>
    </div>
  )}
</div>

<style>
  .author {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 1.5rem 0 2.25rem;
  }

  .author-avatar {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--border);
    background-color: var(--code-bg);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--foreground) 8%, transparent);
    transform: rotate(-3deg);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    flex-shrink: 0;
  }

  .author-avatar:hover {
    transform: rotate(0deg) scale(1.04);
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .author-name a {
    color: var(--foreground);
    text-decoration: none;
  }

  .author-name a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
</style>
