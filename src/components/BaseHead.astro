---
import { getConfig } from "@/utils/config";

type Props = {
  title?: string;
  description?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  image?: string;
};

const { title, description, type = "website", published, updated, image } = Astro.props;
const siteConfig = await getConfig();

const siteTitle = siteConfig.title;

// Format title according to seo.titleTemplate if available
let pageTitle = siteTitle;
if (title) {
  const template = siteConfig.seo?.titleTemplate || "%s | %s";
  if (template.includes("%s")) {
    const parts = template.split("%s");
    if (parts.length >= 3) {
      pageTitle = `${parts[0]}${title}${parts[1]}${siteTitle}${parts.slice(2).join("")}`;
    } else {
      pageTitle = `${title} | ${siteTitle}`;
    }
  } else {
    pageTitle = `${title} | ${siteTitle}`;
  }
}

const pageDescription = description ?? siteConfig.description;
const baseOrigin = Astro.site ?? (siteConfig.seo?.siteUrl ? new URL(siteConfig.seo.siteUrl) : new URL("http://localhost:4321"));
const canonicalURL = new URL(Astro.url.pathname, baseOrigin);
const lang = siteConfig.locale ?? "en";

// Resolved OG image
const ogImage = image || siteConfig.seo?.defaultOgImage;
const ogImageURL = ogImage ? new URL(ogImage, canonicalURL).href : undefined;

// Default theme configuration
const defaultTheme = siteConfig.theme?.default ?? "system";

// Analytics configuration
const analytics = siteConfig.analytics;
const hasAnalytics = Boolean(analytics?.provider && analytics?.id);

const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: pageDescription,
        datePublished: published?.toISOString(),
        dateModified:
          updated?.toISOString() ??
          published?.toISOString(),
        mainEntityOfPage: canonicalURL.href,
        inLanguage: lang,
        publisher: {
          "@type": "Organization",
          name: siteTitle,
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: pageTitle,
        description: pageDescription,
        url: canonicalURL.href,
        inLanguage: lang,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />

<!-- Preload variable fonts -->
<link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

<!-- Prevent theme flashing on initial render -->
<script is:inline define:vars={{ defaultTheme }}>
  (function () {
    const theme = localStorage.getItem('theme') || defaultTheme;
    if (theme === 'dark' || theme === 'light') {
      document.documentElement.setAttribute('data-theme', theme);
    }
  })();
</script>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonicalURL} />
{ogImageURL && <meta property="og:image" content={ogImageURL} />}
{type === "article" && published && (
  <meta property="article:published_time" content={published.toISOString()} />
)}
{type === "article" && updated && (
  <meta property="article:modified_time" content={updated.toISOString()} />
)}

<meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
{siteConfig.seo?.twitterHandle && (
  <meta name="twitter:site" content={siteConfig.seo.twitterHandle} />
  <meta name="twitter:creator" content={siteConfig.seo.twitterHandle} />
)}

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

{/* Optional Analytics */}
{hasAnalytics && analytics?.provider === 'plausible' && (
  <script
    defer
    data-domain={analytics.id}
    src={analytics.host || "https://plausible.io/js/script.js"}
  />
)}
{hasAnalytics && analytics?.provider === 'fathom' && (
  <script
    defer
    data-site={analytics.id}
    src={analytics.host || "https://cdn.usefathom.com/script.js"}
  />
)}
{hasAnalytics && analytics?.provider === 'umami' && (
  <script
    defer
    data-website-id={analytics.id}
    src={analytics.host || "https://cloud.umami.is/script.js"}
  />
)}
