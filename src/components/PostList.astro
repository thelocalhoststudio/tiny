---
import type { Post } from "@/types";
import { getPostUrl } from "@/utils/content";
import { formatDate, formatShortDate } from "@/utils/text";

type Props = {
  posts: Post[];
  showYear?: boolean;
};

const { posts, showYear = true } = Astro.props;
---

<ul class:list={["post-list", { "post-list--with-year": showYear }]}>
  {posts.map((post) => (
    <li>
      <time datetime={post.data.published.toISOString()}>
        {showYear ? formatDate(post.data.published) : formatShortDate(post.data.published)}
      </time>
      <a href={getPostUrl(post.id, post.filePath)}>{post.data.title}</a>
    </li>
  ))}
</ul>
