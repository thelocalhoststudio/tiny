---
import { formatDate } from "@/utils/text";

type Props = {
  title: string;
  description?: string;
  published?: Date;
  updated?: Date;
};

const { title, description, published, updated } = Astro.props;
---

<header>
  <h1 class="title">{title}</h1>
  {(published || updated) && (
    <p class="meta">
      {published && <time datetime={published.toISOString()}>{formatDate(published)}</time>}
      {updated && (
      <>
        <span aria-hidden="true"> · </span>
        <span>
          updated{" "}
          <time datetime={updated.toISOString()}>
            {formatDate(updated)}
          </time>
        </span>
      </>
    )}
    </p>
  )}
</header>
